# -----------------------------
# Modena Play (API) - .env example
# -----------------------------

# ENV
NODE_ENV=development
PORT=10000

# Supabase
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>

# ✅ Needed for Affiliate Links module (create links, click tracking, analytics)
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# Admin bootstrap (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# JWT secret (used for admin JWT + as a salt for click ip_hash)
JWT_SECRET=change_me_super_secret

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,https://<your-frontend>.onrender.com

# Frontend base url (recommended for password reset redirect)
WEB_URL=http://localhost:5173

# Optional Postgres URL (only for DB wizard / future modules)
# You can use Supabase Postgres connection string here.
DATABASE_URL=
